{
  "name": "javel-prisma-adapter",
  "version": "0.0.1",
  "description": "Standalone lifecycle adapters for popular JS/TS ORMs",
  "type": "module",
  "license": "MIT",
  "author": "Abdou Jammeh",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
